---
import { getCollection } from "astro:content";
import { openGraph } from "../config.ts";
import Card from "../components/Card.astro";
import PostList from "../components/PostList.astro";
import TagList from "../components/TagList.astro";
import Layout from "../layouts/Layout.astro";

const library = await getCollection("library", (library) => library.data.unlisted !== true);

const tags = library.flatMap(library => library.data.tags);
const taglibraryCounts = library.reduce((state, library) => {
	library.data.tags.forEach(tag => {
		state[tag] = (state[tag] ?? 0) + 1;
	});
	return state;
}, {} as Record<string, number>);
---
<Layout
	pageTitle={openGraph.library.pageTitle}
	title={openGraph.library.title}
	description={openGraph.library.description}
	image={openGraph.library.image}
	pagefindIgnore
>
	<div class="layout-grid__left" slot="left">
		<Card title="filter by tag" icon="lucide/tags">
			<TagList
				tags={tags.map((tag) => ({
					tag: tag,
					text: `${tag} (${taglibraryCounts[tag]})`,
					href: "/library",
				}))}
			/>
		</Card>
	</div>
	<div class="layout-grid__right" slot="right">
		<Card title={`library (${library.length})`} icon="lucide/rss" id="library-card">
			<libraryList
				library={
					library.map((library) => ({
						url: `/library/${library.id}`,
						tags: library.data.tags,
						title: library.data.title,
						description: library.data.description,
						image: library.data.image,
					}))
				}
			/>
		</Card>
	</div>
</Layout>

<script>
	const tags = document.querySelectorAll<HTMLElement>('.tag-list .tag');
	const library = document.querySelectorAll<HTMLElement>('#library-card .library');
	const libraryCardTitle = document.querySelector<HTMLElement>('#library-card .card__title');
	const url = new URL(window.location.href);
	const initialTags = url.searchParams.get('tags')?.split(',').filter((tag) => tag.length > 0) || [];
	const selectedTags = new Set(initialTags);

	function updatelibraryVisibility() {
		let count = 0;
		library.forEach((library) => {
			const libraryTags = library.dataset.tags!.split(',');
			// if there are selected tags and the library does not have all of them, hide the library
			if (selectedTags.size > 0 && ![...selectedTags].every((tag) => libraryTags.includes(tag))) {
				library.style.display = 'none';
			} else {
				library.style.display = '';
				count++;
			}
		});

		if(libraryCardTitle) {
			libraryCardTitle.textContent = `library (${count})`;
		}
	}

	function updateURL() {
		// create a "clean" URL for the current page before adding the new query parameters
		const newUrl = new URL(window.location.pathname, window.location.origin);
		if (selectedTags.size > 0) {
			newUrl.searchParams.set('tags', [...selectedTags].join(','));
		}
		history.pushState({ tags: [...selectedTags] }, '', newUrl);
	}

	tags.forEach((tag) => {
		const tagValue = tag.dataset.tag!;
		if (selectedTags.has(tagValue)) {
			tag.classList.add('tag--active');
		}

		tag.addEventListener('click', (event) => {
			event.preventDefault();

			tag.classList.toggle('tag--active');

			if (selectedTags.has(tagValue)) {
				selectedTags.delete(tagValue);
			} else {
				selectedTags.add(tagValue);
			}

			updatelibraryVisibility();
			updateURL();
		});
	});

	updatelibraryVisibility();
</script>