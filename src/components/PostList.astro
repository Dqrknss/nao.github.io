---
import type { HTMLAttributes } from "astro/types";
import type { Props as PostProps } from "./Post.astro";
import Post from "./Post.astro";

interface Props extends HTMLAttributes<"div"> {
	posts: PostProps[],
	offset?: number,
	limit?: number,
}

const { posts, offset, limit, ...props } = Astro.props;

const sortTime = (date: string | Date) => 
	date instanceof Date ? date.getTime() : Number.MAX_SAFE_INTEGER;
---

<div class="post-list" {...props}>
	{
		posts
			.sort((a, b) => sortTime(b.date) - sortTime(a.date))
			.slice(offset ?? 0, limit && (offset ?? 0 + limit))
			.map((post) => (
				<Post {...post} />
			))
	}
</div>

<style>
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
</style>